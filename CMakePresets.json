{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC (Visual Studio 2022, multi-config)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "ninja-msvc",
      "displayName": "MSVC + Ninja (requer Developer Shell)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl", "CMAKE_C_COMPILER": "cl" }
    },
    {
      "name": "ninja-clang-cl",
      "displayName": "clang-cl + Ninja (requer Developer Shell e LLVM)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang-cl", "CMAKE_C_COMPILER": "clang-cl" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "ninja-msvc-debug", "configurePreset": "ninja-msvc", "configuration": "Debug" },
    { "name": "ninja-msvc-release", "configurePreset": "ninja-msvc", "configuration": "Release" },
    { "name": "ninja-clang-cl-debug", "configurePreset": "ninja-clang-cl", "configuration": "Debug" },
    { "name": "ninja-clang-cl-release", "configurePreset": "ninja-clang-cl", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
