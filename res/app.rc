#include <winres.h>
#include "resource.h"
#include "version.h"

// Manifesto da aplicação (ID 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, tipo 24 = RT_MANIFEST).
1 24 "app.manifest"

IDI_APP ICON "app.ico"

// Shaders internos (a pasta shaders/ está nos include dirs do rc).
IDR_SHADER_GRID RCDATA "grid.hlsl"
IDR_SHADER_PRELUDE RCDATA "prelude.hlsl"
IDR_SHADER_EPILOGUE RCDATA "epilogue.hlsl"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ASCIIPAPER_VERSION_MAJOR, ASCIIPAPER_VERSION_MINOR, ASCIIPAPER_VERSION_PATCH, 0
 PRODUCTVERSION ASCIIPAPER_VERSION_MAJOR, ASCIIPAPER_VERSION_MINOR, ASCIIPAPER_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AsciiPaper"
            VALUE "FileDescription", "AsciiPaper - ASCII wallpapers"
            VALUE "FileVersion", ASCIIPAPER_VERSION_STR
            VALUE "InternalName", "asciipaper"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "asciipaper.exe"
            VALUE "ProductName", "AsciiPaper"
            VALUE "ProductVersion", ASCIIPAPER_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
